# Local development environment template. Never commit real credentials.
# GitHub token: needed for private repository reads and live PR review publishing.
# Use a fine-grained token with minimum required repository permissions.
GITHUB_TOKEN=

# Optional: enables the OpenAI-backed analyzer.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional application logging level.
LOG_LEVEL=INFO
